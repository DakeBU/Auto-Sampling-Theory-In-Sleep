    (hm : mCross ≤ fisherDissipation / 4 + residualTerm)
    (hdelta :
      deltaCross ≤ fisherDissipation / 4 + frozenKlTerm + frozenDeltaTerm) :
    -fisherDissipation + deltaCross + mCross ≤
