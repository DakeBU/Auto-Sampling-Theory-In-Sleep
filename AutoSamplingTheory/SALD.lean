theorem generalMovingTargetDiscreteWeakConditionalFpDriftSourceOfBarBNoBoundaryIntegral
    {State Vec Test : Type*} [MeasurableSpace State]
    (hatRhoS : MeasureTheory.Measure State) (barB : State → Vec)
    (testGradPairing : Test → State → Real)
    (weakGradPairing : (State → Vec) → Test → Real)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction driftDiv : Test → Real)
    (hdriftBarBAction :
