theorem generalMovingTargetDiscreteHatRhoMarginalOfJointMap
    {Ω E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    (P : MeasureTheory.Measure Ω) (Xk hatXAtS : Ω → E)
    (hatRhoS : MeasureTheory.Measure E)
    (hXk : Measurable Xk) (hhatXAtS : Measurable hatXAtS)
    (hhatRhoS : hatRhoS = MeasureTheory.Measure.map hatXAtS P) :
    MeasureTheory.Measure.map Prod.snd
        (MeasureTheory.Measure.map (fun ω => (Xk ω, hatXAtS ω)) P) =
      hatRhoS := by
  calc
    MeasureTheory.Measure.map Prod.snd
        (MeasureTheory.Measure.map (fun ω => (Xk ω, hatXAtS ω)) P) =
        MeasureTheory.Measure.map hatXAtS P := by
      exact lawMapProdSnd (P := P) (X := Xk) (Y := hatXAtS) hXk hhatXAtS
