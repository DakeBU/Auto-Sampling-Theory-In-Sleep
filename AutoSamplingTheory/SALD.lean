    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hsampleGenerator :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        HasDerivAt
          (fun s => ∫ ω, testEval φ (hatX s ω) ∂P)
