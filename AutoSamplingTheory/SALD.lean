theorem generalMovingTargetDiscreteResidualYoungCoefficientScalar
    (sigmaSq sigmaInvSq dotT energy : Real)
    (hsigmaInvSq : sigmaInvSq = sigmaSq⁻¹)
    (hsigmaSq : sigmaSq ≠ 0) :
    (1 / (2 * (sigmaSq / 4))) * (dotT ^ 2 * energy) =
      2 * sigmaInvSq * dotT ^ 2 * energy := by
  rw [hsigmaInvSq]
  field_simp [hsigmaSq]
