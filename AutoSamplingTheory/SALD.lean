    (hpairMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable (testGradPairing φ) hatRhoS)
    (hpairNormBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
