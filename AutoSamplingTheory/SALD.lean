theorem generalMovingTargetDiscreteCondDistribNamedBarBAeEqOfCondExpKernelSourceDef
    {Ω State Vec : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec]
    [StandardBorelSpace Ω] [StandardBorelSpace State] [Nonempty State]
