    {
      "id": "method:ula",
      "kind": "perspective-method",
      "label": "ULA / Langevin MC",
      "position": [
        560,
        0
      ],
      "library_scope": [
        "mcmc",
        "log-concave-sampling"
      ],
      "summary": "Fixed-step Euler proposal is generally biased for pi; invariant law existence and bias bounds require their own assumptions.",
      "formula": "X_{k+1}=X_k-h\\nabla V(X_k)+\\sqrt{2h}\\xi_k",
      "source_ids": [
        "mcmc-primary"
      ]
    },
    {
      "id": "method:mala",
      "kind": "perspective-method",
      "label": "MALA / Metropolized Langevin",
      "position": [
        560,
        112
      ],
      "library_scope": [
        "mcmc",
        "log-concave-sampling"
      ],
      "summary": "Corrected Langevin proposal; exact invariant target under the MH contract does not mean iid or exact finite-time draws.",
      "formula": "Q_h\\;\\xrightarrow{\\mathrm{MH}}\\;P_\\pi",
      "source_ids": [
        "mcmc-primary"
      ]
    },
    {
      "id": "method:rwm",
      "kind": "perspective-method",
      "label": "Random-walk Metropolis",
      "position": [
        560,
        224
      ],
      "library_scope": [
        "mcmc",
        "log-concave-sampling"
      ],
      "summary": "A general MH instance; log-concavity is one target regime, not a prerequisite for defining the algorithm.",
      "formula": "Y=X+\\varepsilon",
      "source_ids": [
        "mcmc-primary"
      ]
    },
    {
      "id": "method:hitrun",
      "kind": "perspective-method",
      "label": "Hit-and-Run",
      "position": [
        560,
        336
      ],
      "library_scope": [
        "mcmc",
        "log-concave-sampling"
      ],
      "summary": "Continuous-state, discrete-time chain: choose a direction and sample its chord. Full dimension, bounded volume, access model and initialization belong to the theorem.",
      "formula": "Y\\sim\\operatorname{Unif}(K\\cap(x+\\mathbb R u))",
      "source_ids": [
        "mcmc-geometry"
      ]
    },
    {
      "id": "method:glauber",
      "kind": "perspective-method",
      "label": "Gibbs / Glauber",
      "position": [
        560,
        448
      ],
      "library_scope": [
        "mcmc",
        "discrete-sampling"
      ],
      "summary": "Conditional resampling on feasible support. Random scan and systematic scan differ; stationarity is not rapid mixing.",
      "formula": "\\sigma_i\\sim\\pi(\\,\\cdot\\mid\\sigma_{-i})",
      "source_ids": [
        "mcmc-primary"
      ]
    },
    {
      "id": "method:hmc",
      "kind": "perspective-method",
      "label": "Hamiltonian Monte Carlo",
      "position": [
        560,
        560
      ],
      "library_scope": [
        "mcmc",
        "log-concave-sampling",
        "riemannian-optimization"
      ],
      "summary": "Augmented-state method. Standard and nonreversible variants differ; geometric connection is a planned analytic perspective, not a theorem.",
      "formula": "H(x,p)=V(x)+\\tfrac12p^\\top M^{-1}p",
      "source_ids": [
        "mcmc-primary"
      ]
    },
    {
      "id": "method:pdmp",
      "kind": "perspective-method",
      "label": "PDMP / lifted dynamics",
      "position": [
        560,
        672
      ],
      "library_scope": [
        "mcmc"
      ],
      "summary": "Deterministic motion plus jumps; generator stationarity needs existence/nonexplosion and domain conditions.",
      "formula": "L=A+J",
      "source_ids": [
        "mcmc-primary"
      ]
    },
