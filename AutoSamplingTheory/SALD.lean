theorem generalMovingTargetDiscreteWeakConditionalFpDriftSourceOfBarBWeakAction
    {State Vec Test F : Type*} [AddCommGroup F]
    (barB : State → Vec)
    (weakGradPairing : (State → Vec) → Test → F)
