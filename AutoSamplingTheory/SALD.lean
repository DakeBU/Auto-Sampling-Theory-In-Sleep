theorem generalMovingTargetDiscretePointwiseGronwallInputOfPostDvTimeChanged
    (K dKds dKdt cLSI sigmaSq sigmaInvSq dotS dotT eAlpha gamma delta :
      Real → Real)
    (alphaInv etaSq alphaPrimeInv eta : Real)
    (hdotSNonneg : ∀ t, 0 ≤ dotS t)
