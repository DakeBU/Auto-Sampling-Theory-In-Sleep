      2 * sigmaInvSq * dotS⁻¹ * alphaInv := by
  calc
    dotS * (2 * sigmaInvSq * dotT ^ 2 * alphaInv)
        = (2 * sigmaInvSq * alphaInv) * (dotS * dotT ^ 2) := by
          ring
    _ = (2 * sigmaInvSq * alphaInv) * dotS⁻¹ := by
          rw [generalMovingTargetDiscreteConstantScheduleSquareScalar
            dotS dotT hdotT hdotS]
