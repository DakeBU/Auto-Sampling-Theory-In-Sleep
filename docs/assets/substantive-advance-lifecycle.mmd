  classDef verified fill:#fff2c7,stroke:#9a6700,color:#172033,stroke-width:1.8px;
  classDef stable fill:#dcecff,stroke:#155eef,color:#172033,stroke-width:2px;
  classDef merged fill:#dcecff,stroke:#155eef,color:#172033,stroke-width:2.2px;
  classDef blocked fill:#ffe5e5,stroke:#c92a2a,color:#172033,stroke-width:2px;
