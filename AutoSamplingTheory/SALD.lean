theorem forwardKlPreDvDerivativeBoundScalar
    (dKds dKdt firstTerm targetTerm fisher tildeVelocitySq velocitySq kl cLSI
      dotS dotT : Real)
    (hfisher : 0 ≤ fisher)
    (htildeVelocitySq : 0 ≤ tildeVelocitySq)
    (hdotSNonneg : 0 ≤ dotS)
    (hkl : dKds = firstTerm + targetTerm)
    (hfirst : firstTerm = -fisher)
    (hcauchy : targetTerm ≤ Real.sqrt fisher * Real.sqrt tildeVelocitySq)
    (hlsiHalf : cLSI * kl ≤ (1 / 2) * fisher)
    (hdKdt : dKdt = dotS * dKds)
    (hvelocity : tildeVelocitySq = dotT ^ 2 * velocitySq)
    (hdotT : dotT = dotS⁻¹)
    (hdotS : dotS ≠ 0) :
    dKdt ≤ -(dotS * cLSI) * kl + (1 / 2) * dotS⁻¹ * velocitySq := by
  have hpost :
      dKds ≤ -(1 / 2) * fisher + (1 / 2) * tildeVelocitySq := by
    exact forwardKlPostYoungDerivativeBoundOfCauchyScalar
      dKds firstTerm targetTerm fisher tildeVelocitySq
      hfisher htildeVelocitySq hkl hfirst hcauchy
  have hlsi :
      dKds ≤ -cLSI * kl + (1 / 2) * tildeVelocitySq := by
    exact forwardKlLsiDerivativeBoundScalar
      dKds fisher tildeVelocitySq kl cLSI hpost hlsiHalf
  exact forwardKlTimeChangedDerivativeBoundScalar
    dKds dKdt kl cLSI tildeVelocitySq velocitySq dotS dotT
    hdotSNonneg hdKdt hlsi hvelocity hdotT hdotS

/-- Pre-DV derivative pipeline with source-shaped inverse-schedule input.

