theorem generalMovingTargetDiscreteCondDistribNamedDriftRegularity
    {Ω State Vec : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec]
    [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatRhoS : MeasureTheory.Measure State}
    {hatXAtS Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    {barB condC condScore : State → Vec}
    (dotTk sigmaCoeff : Real)
    (hhatRhoS : hatRhoS = MeasureTheory.Measure.map hatXAtS P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
