theorem generalMovingTargetDiscreteFrozenResidualAlgebraVector
    {E : Type*} [AddCommGroup E] [Module Real E]
    (dotT : Real) (score frozen c v m delta tildeV : E)
    (hm : m = v - c)
    (hdelta : delta = dotT • c + score - frozen)
    (htildeV : tildeV = dotT • v) :
    score - frozen + tildeV = delta + dotT • m := by
  subst m
  subst delta
  subst tildeV
  simp [sub_eq_add_neg, smul_add, smul_neg]
