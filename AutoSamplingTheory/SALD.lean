    generalMovingTargetDiscretePostLsiDerivativeBoundScalar
      dKds fisher kl cLSI
      (2 * sigmaInvSq * dotT ^ 2 * residualSq +
        2 * gamma * etaSq * alphaPrimeInv * kl + 2 * delta * eta)
      sigmaSq hsigmaSq (by simpa [add_assoc] using hpostYoung) hlsiHalf
  have hpostDv :
      dKds ≤
        -((((sigmaSq / 2) * cLSI) -
          2 * sigmaInvSq * dotT ^ 2 * alphaInv -
          2 * gamma * etaSq * alphaPrimeInv) * kl) +
          2 * sigmaInvSq * dotT ^ 2 * eAlpha + 2 * delta * eta :=
    generalMovingTargetDiscretePostDvDerivativeBoundScalar
      dKds kl cLSI sigmaSq sigmaInvSq dotT alphaInv residualSq eAlpha gamma
