theorem generalMovingTargetDiscreteWeakConditionalFpSourceSignsOfSampleGeneratorPiecesHandoff
    {Ω State Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    (P : MeasureTheory.Measure Ω) (hatX : Real → Ω → State)
    (testEval : Test → State → Real)
