  calc
    MeasureTheory.Measure.map Prod.fst
        (MeasureTheory.Measure.map (fun ω => (hatXAtS ω, Xk ω)) P) =
        MeasureTheory.Measure.map hatXAtS P := by
      exact lawMapProdFst (P := P) (X := hatXAtS) (Y := Xk) hhatXAtS hXk
