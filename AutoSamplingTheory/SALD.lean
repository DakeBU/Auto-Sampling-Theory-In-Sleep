theorem generalMovingTargetDiscreteDerivativeDvTimeChangedScalar
    (dKds dKdt fisher mCross deltaCross residualSq kl cLSI sigmaSq
      sigmaInvSq dotS dotT alphaInv eAlpha gamma etaSq alphaPrimeInv delta eta :
      Real)
    (hsigmaSq : 0 ≤ sigmaSq)
    (hdotSNonneg : 0 ≤ dotS)
    (hcoeff : 0 ≤ 2 * sigmaInvSq * dotT ^ 2)
    (hderiv : dKds = -(sigmaSq / 2) * fisher + deltaCross + mCross)
    (hm : mCross ≤ (sigmaSq / 8) * fisher +
