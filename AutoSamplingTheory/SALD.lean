def saldSourceForLabel (label : String) : SourceAnchor :=
  if label = "lem:gronwall" then saldGronwallSource
  else if label = "lem:dv_variation" then saldDvVariationSource
  else if label = "def:PI" then saldPiSource
  else if label = "eq:LSI-KL-FI" then saldKlFiLsiSource
  else if label = "thm:forward-KL" then saldForwardKlSource
  else if label = "thm:forward-KL-discrete" then saldForwardKlDiscreteSource
  else if label = "prop:guided_path_residual" then saldGuidedResidualSource
  else if label = "thm:general-moving-target-SALD" then saldGeneralMovingTargetSource
  else if label = "thm:unified-forward-KL" then saldUnifiedForwardKlSource
  else if label = "thm:general-moving-target-SALD-discrete" then saldGeneralMovingTargetDiscreteSource
  else saldAppendixSource

def saldLeanTargetForLabel (label : String) : String :=
  if label = "lem:dv_variation" || label = "def:PI" || label = "eq:LSI-KL-FI" then "AutoSamplingTheory/Probability.lean"
  else "AutoSamplingTheory/SALD.lean"

