[
  {"id":"chewi-1-1-display-1-1-7","formula":"\\|\\eta\\|_{L^2(\\mathbb P\\otimes dt)}^2=\\mathbb E\\!\\left[\\int_0^T |\\eta_t|^2\\,dt\\right]<\\infty"},
  {"id":"chewi-1-1-display-1-1-2","formula":"\\eta_t=\\sum_{k=0}^{m-1}H_k\\,\\mathbf 1_{(t_k,t_{k+1}]}(t),\\qquad H_k\\in L^\\infty(\\mathcal F_{t_k})"},
  {"id":"chewi-1-1-display-1-1-3","formula":"\\int_0^T\\eta_t\\,dB_t:=\\sum_{k=0}^{m-1}H_k\\bigl(B_{t_{k+1}\\wedge T}-B_{t_k\\wedge T}\\bigr)"},
  {"id":"chewi-1-1-definition-1-1-1","formula":"B_0=0,\\qquad B_t-B_s\\sim\\mathcal N(0,(t-s)I),\\qquad 0\\le s<t,\\qquad t\\mapsto B_t\\text{ continuous a.s.}"},
  {"id":"chewi-1-1-definition-1-1-12","formula":"\\tau_n\\le\\tau_{n+1},\\qquad \\tau_n\\uparrow T\\ \\text{a.s.},\\qquad \\mathbb E\\!\\int_0^T|\\eta_s|^2\\mathbf 1_{\\{s\\le\\tau_n\\}}\\,ds<\\infty"},
  {"id":"chewi-1-1-definition-1-1-15","formula":"M\\in\\mathcal M_{\\mathrm{loc}}\\iff\\exists\\,\\tau_n\\uparrow\\infty\\ \\text{a.s. such that }M^{\\tau_n}\\in\\mathcal M\\ \\text{for every }n"},
  {"id":"chewi-1-1-definition-1-1-4","formula":"0\\le s\\le t\\quad\\Longrightarrow\\quad \\mathbb E[M_t\\mid\\mathcal F_s]=M_s"},
  {"id":"chewi-1-1-definition-1-1-11","formula":"\\tau\\text{ is a stopping time}\\iff\\{\\tau\\le t\\}\\in\\mathcal F_t\\quad\\text{for every }t\\ge0"},
  {"id":"chewi-1-1-display-1-1-14","formula":"\\eta^{(n)}_s:=\\eta_s\\mathbf 1_{\\{s\\le\\tau_n\\}},\\qquad \\mathbb E\\!\\int_0^T|\\eta^{(n)}_s|^2\\,ds<\\infty,\\qquad M^{(n)}_t:=\\int_0^t\\eta^{(n)}_s\\,dB_s"},

  {"id":"chewi-1-2-definition-1-2-1","formula":"P_t f(x):=\\mathbb E[f(X_t)\\mid X_0=x]"},
  {"id":"chewi-1-2-semigroup","formula":"P_0=I,\\qquad P_{s+t}=P_sP_t=P_tP_s"},
  {"id":"chewi-1-2-lemma-1-2-2","formula":"K_0(x,\\cdot)=\\delta_x,\\quad K_{s+t}(x,A)=\\int K_t(y,A)K_s(x,dy)\\quad\\Longrightarrow\\quad P_{s+t}=P_sP_t"},
  {"id":"chewi-1-2-definition-1-2-3","formula":"Lf:=\\lim_{t\\downarrow0}\\frac{P_tf-f}{t}"},
  {"id":"chewi-1-2-proposition-1-2-5","formula":"\\frac{d}{dt}P_tf=P_tLf=LP_tf"},
  {"id":"chewi-1-2-generator","formula":"L=\\left.\\frac{d}{dt}P_t\\right|_{t=0}"},
  {"id":"chewi-1-2-definition-1-2-10","formula":"\\int f\\,P_tg\\,d\\pi=\\int g\\,P_tf\\,d\\pi\\qquad(t\\ge0)"},
  {"id":"chewi-1-2-display-1-2-11","formula":"(P_tf)^2\\le P_t(f^2)"},
  {"id":"chewi-1-2-definition-1-2-12","formula":"\\Gamma(f,g):=\\frac12\\bigl(L(fg)-fLg-gLf\\bigr)"},
  {"id":"chewi-1-2-lemma-1-2-13","formula":"\\Gamma(f,f)\\ge0"},
  {"id":"chewi-1-2-theorem-1-2-14","formula":"-\\int fLg\\,d\\pi=-\\int gLf\\,d\\pi=\\int\\Gamma(f,g)\\,d\\pi"},
  {"id":"chewi-1-2-corollary-1-2-15","formula":"-\\langle f,Lf\\rangle_{L^2(\\pi)}=\\int\\Gamma(f,f)\\,d\\pi\\ge0"},
  {"id":"chewi-1-2-example-1-2-17","formula":"L=\\Delta-\\langle\\nabla V,\\nabla\\cdot\\rangle\\quad\\Longrightarrow\\quad \\Gamma(f,g)=\\langle\\nabla f,\\nabla g\\rangle,\\qquad \\Gamma(f,f)=\\|\\nabla f\\|^2"},
  {"id":"chewi-1-2-definition-1-2-19","formula":"\\operatorname{Var}_\\pi(f)\\le C_{\\mathrm P}\\int\\Gamma(f,f)\\,d\\pi"},
  {"id":"chewi-1-2-gronwall","formula":"g'(t)\\le c\\,g(t)\\quad\\Longrightarrow\\quad g(t)\\le e^{ct}g(0)"},
  {"id":"chewi-1-2-definition-1-2-25","formula":"\\operatorname{Ent}_\\pi(f)\\le\\frac{C_{\\mathrm{LSI}}}{2}\\int\\Gamma(f,\\log f)\\,d\\pi,\\qquad f\\ge0,\\quad\\int f\\,d\\pi=1"},
  {"id":"chewi-1-2-definition-1-2-28","formula":"\\Gamma_2(f,g):=\\frac12\\bigl(L\\Gamma(f,g)-\\Gamma(f,Lg)-\\Gamma(g,Lf)\\bigr)"},
  {"id":"chewi-1-2-definition-1-2-29","formula":"\\mathrm{CD}(\\alpha,\\infty):\\qquad \\Gamma_2(f,f)\\ge\\alpha\\,\\Gamma(f,f)\\qquad(\\alpha>0)"},
  {"id":"chewi-1-2-langevin-generator","formula":"dX_t=-\\nabla V(X_t)\\,dt+\\sqrt2\\,dB_t,\\qquad Lf=\\Delta f-\\langle\\nabla V,\\nabla f\\rangle"},
  {"id":"chewi-1-2-weighted-ibp","formula":"\\int fLg\\,d\\pi=-\\int\\langle\\nabla f,\\nabla g\\rangle\\,d\\pi=\\int gLf\\,d\\pi,\\qquad d\\pi\\propto e^{-V}dx"},
  {"id":"chewi-1-2-stationarity","formula":"\\int P_tf\\,d\\pi=\\int f\\,d\\pi\\qquad(t\\ge0)"},
  {"id":"chewi-1-3-poincare","formula":"\\frac{d}{dt}\\operatorname{Var}_\\pi(P_tf)=-2\\int\\Gamma(P_tf,P_tf)\\,d\\pi\\le-\\frac{2}{C_{\\mathrm P}}\\operatorname{Var}_\\pi(P_tf)"},
  {"id":"chewi-1-3-log-sobolev","formula":"\\frac{d}{dt}\\operatorname{Ent}_\\pi(P_tf)=-\\int\\Gamma(P_tf,\\log P_tf)\\,d\\pi\\le-\\frac{2}{C_{\\mathrm{LSI}}}\\operatorname{Ent}_\\pi(P_tf)"},

  {"id":"chewi-1-3-definition-1-3-1","formula":"\\mathcal T_c(\\mu,\\nu):=\\inf_{\\gamma\\in\\Pi(\\mu,\\nu)}\\int c(x,y)\\,d\\gamma(x,y)"},
  {"id":"chewi-1-3-display-1-3-2","formula":"\\mathcal T_c(\\mu,\\nu)=\\inf_{\\gamma\\in\\Pi(\\mu,\\nu)}\\int_{X\\times Y}c(x,y)\\,d\\gamma(x,y)"},
  {"id":"chewi-1-3-definition-1-3-4","formula":"W_2(\\mu,\\nu):=\\left(\\inf_{\\gamma\\in\\Pi(\\mu,\\nu)}\\int\\|x-y\\|^2\\,d\\gamma(x,y)\\right)^{1/2}"},
  {"id":"chewi-1-3-display-1-3-5","formula":"W_2^2(\\mu,\\nu)=\\inf_{\\gamma\\in\\Pi(\\mu,\\nu)}\\int\\|x-y\\|^2\\,d\\gamma(x,y)"},
  {"id":"chewi-1-3-definition-1-3-6","formula":"\\mathcal D_c(\\mu,\\nu):=\\sup_{f(x)+g(y)\\le c(x,y)}\\left\\{\\int f\\,d\\mu+\\int g\\,d\\nu\\right\\}"},
  {"id":"chewi-1-3-display-1-3-7","formula":"\\mathcal D_c(\\mu,\\nu)=\\sup\\left\\{\\int f\\,d\\mu+\\int g\\,d\\nu:\\ f\\oplus g\\le c\\right\\}"},
  {"id":"chewi-1-3-definition-1-3-12","formula":"\\mathcal P_{2,\\mathrm{ac}}(\\mathbb R^d):=\\left\\{\\mu\\ll dx:\\int_{\\mathbb R^d}\\|x\\|^2\\,d\\mu(x)<\\infty\\right\\}"},
  {"id":"chewi-1-3-definition-1-3-16","formula":"|\\dot\\mu_t|:=\\lim_{h\\to0}\\frac{W_2(\\mu_{t+h},\\mu_t)}{|h|}\\quad\\text{for a.e. }t"},
  {"id":"chewi-1-3-definition-1-3-25","formula":"\\mu_t:=((1-t)x+ty)_\\#\\gamma^*,\\qquad \\gamma^*\\in\\operatorname*{argmin}_{\\gamma\\in\\Pi(\\mu_0,\\mu_1)}\\int\\|x-y\\|^2\\,d\\gamma"},
  {"id":"chewi-1-3-definition-1-3-26","formula":"\\mathcal F(\\mu_t)\\le(1-t)\\mathcal F(\\mu_0)+t\\mathcal F(\\mu_1)-\\frac{\\alpha}{2}t(1-t)W_2^2(\\mu_0,\\mu_1)"},

  {"id":"chewi-1-4-display-1-4-7","formula":"\\mathcal F(\\nu)\\ge\\mathcal F(\\mu)+\\left.\\frac{d}{dt}\\mathcal F(\\mu_t)\\right|_{t=0^+}+\\frac{\\alpha}{2}W_2^2(\\mu,\\nu)"},
  {"id":"chewi-1-1-definition-1-1-17","formula":"X_t=X_0+\\int_0^t b_s\\,ds+\\int_0^t\\sigma_s\\,dB_s,\\qquad X_t\\in\\mathbb R^d,\\quad B_t\\in\\mathbb R^N,\\qquad \\int_0^T\\|b_s\\|\\,ds<\\infty,\\quad\\int_0^T\\|\\sigma_s\\|_{\\mathrm{HS}}^2\\,ds<\\infty\\ \\text{a.s.}"}
