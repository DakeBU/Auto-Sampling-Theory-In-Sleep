    {E F : Type*} [AddCommGroup E] [AddCommGroup F] [Module Real F]
    (D : E → F)
    (partialS laplacian : F) (sigmaEta sigmaCoeff : Real) (frozen : E)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
